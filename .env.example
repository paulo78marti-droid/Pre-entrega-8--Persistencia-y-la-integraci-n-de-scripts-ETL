# ==========================================
# Configuración del Pipeline ETL Meteorológico
# ==========================================

# Parámetros de la API Open-Meteo
API_BASE_URL=https://api.open-meteo.com/v1/forecast
CITY_NAME=Buenos Aires
LATITUDE=-34.61
LONGITUDE=-58.38
TIMEZONE=America/Argentina/Buenos_Aires

# Base de datos analítica local (SQLite con SQLAlchemy 2.0)
DATABASE_URL=sqlite:///data/weather_analytics.db

# Parámetros de resiliencia y timeouts
REQUEST_TIMEOUT=15
MAX_RETRIES=5
RETRY_BACKOFF_FACTOR=2
