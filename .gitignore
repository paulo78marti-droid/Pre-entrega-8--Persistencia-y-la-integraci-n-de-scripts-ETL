# Git ignore for Data Science & ETL project

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local

# Database & SQLite files
*.db
*.sqlite3
*.duckdb

# Staging raw data (preserve folder structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep

# IDEs & OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
